# Google Gemini API key (required) - create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Tavily web-search API key (used for the agent's search tool) - https://app.tavily.com
TAVILY_API_KEY=your-tavily-api-key-here

# --- Optional ---
# Which Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Sampling temperature. Leave unset to use the model's default.
# GEMINI_TEMPERATURE=

# Port for hosting platforms such as Render (injected automatically there).
# PORT=7860
